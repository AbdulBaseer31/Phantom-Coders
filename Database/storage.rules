rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isDoctor() { return signedIn() && request.auth.token.role == 'doctor'; }
    function isOwner(patientId) { return signedIn() && request.auth.uid == patientId; }
    function assignedDoctor(patientId) {
      return isDoctor() && firestore.exists(/databases/(default)/documents/patients/$(patientId)/careTeam/$(request.auth.uid));
    }
    function canAccessPatientAudio(patientId) { return isOwner(patientId) || assignedDoctor(patientId) || isAdmin(); }

    match /patientAudio/{patientId}/{fileName} {
      allow read: if canAccessPatientAudio(patientId);
      allow write: if isOwner(patientId) || isAdmin();
    }

    match /languagePacks/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
