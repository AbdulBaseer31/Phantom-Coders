rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isDoctor() { return signedIn() && request.auth.token.role == 'doctor'; }
    function isPatient(patientId) { return signedIn() && request.auth.uid == patientId; }
    function assignedDoctor(patientId) {
      return isDoctor() && exists(/databases/$(database)/documents/patients/$(patientId)/careTeam/$(request.auth.uid));
    }
    function canReadPatient(patientId) { return isPatient(patientId) || assignedDoctor(patientId) || isAdmin(); }

    match /patients/{patientId} {
      allow read: if canReadPatient(patientId);
      allow create, update: if isPatient(patientId) && request.resource.data.role == 'patient';
      allow delete: if isAdmin();

      match /careTeam/{doctorId} {
        allow read: if canReadPatient(patientId);
        allow write: if isAdmin();
      }
      match /gameSessions/{sessionId} {
        allow read: if canReadPatient(patientId);
        allow create: if isPatient(patientId)
          && request.resource.data.patientId == patientId
          && request.resource.data.schemaVersion == 1;
        allow update, delete: if isAdmin();
      }
      match /medications/{eventId} {
        allow read: if canReadPatient(patientId);
        allow create: if isPatient(patientId)
          && request.resource.data.patientId == patientId
          && request.resource.data.schemaVersion == 1;
        allow update, delete: if isAdmin();
      }
    }

    match /alerts/{alertId} {
      allow read: if signedIn() && (
        canReadPatient(resource.data.patientId)
      );
      allow write: if isAdmin();
    }

    match /languagePacks/{languageId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isPatient(userId) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
